{
  "name": "@aaron212/astro-highlights",
  "version": "0.0.1",
  "description": "Server-side syntax highlighting with Pierre Highlights for Astro and Sätteri.",
  "keywords": [
    "astro",
    "astro-integration",
    "highlights",
    "satteri",
    "syntax-highlighting"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aaron-212/astro-highlights.git"
  },
  "files": [
    "dist",
    "src/components/*.astro",
    "src/styles.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/Highlights.astro": "./src/components/Highlights.astro",
    "./satteri": {
      "types": "./dist/satteri.d.ts",
      "import": "./dist/satteri.js"
    },
    "./styles.css": "./src/styles.css",
    "./themes": {
      "types": "./dist/themes.d.ts",
      "import": "./dist/themes.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit && astro check --tsconfig tsconfig.astro.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.4",
    "@pierre/highlights": "^0.2.0",
    "satteri": "^0.10.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@types/hast": "^3.0.5",
    "astro": "^7.3.8",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.87.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@astrojs/markdown-satteri": "^0.3.7 || ^0.4.0",
    "astro": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "@astrojs/markdown-satteri": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.10.1"
}
