---
import { codeToTokens, isSupportedLanguage, type Theme, type ThemeFamily } from "@pierre/highlights";
import pierreDark from "@pierre/highlights/themes/pierre-dark";
import pierreLight from "@pierre/highlights/themes/pierre-light";
import type { HTMLAttributes } from "astro/types";
import CodeFrame from "./CodeFrame.astro";
import "../styles.css";

declare const __ASTRO_HIGHLIGHTS_LINE_NUMBERS__: boolean;

export interface Props extends Omit<HTMLAttributes<"pre">, "lang"> {
  /** Source code. Takes precedence over the default slot, including when empty. */
  code?: string;
  /** A Highlights language or alias. Unknown languages render as plain text. */
  lang?: string;
  /** Filename to display above the code in a frame. */
  title?: string;
  /** Override the integration's default for displaying line numbers. */
  lineNumbers?: boolean;
  /** Defaults to Pierre Light and Pierre Dark. */
  themes?: {
    light: Theme | ThemeFamily;
    dark: Theme | ThemeFamily;
  };
}

const {
  code,
  lang = "plaintext",
  title,
  lineNumbers = typeof __ASTRO_HIGHLIGHTS_LINE_NUMBERS__ !== "undefined" && __ASTRO_HIGHLIGHTS_LINE_NUMBERS__,
  themes = { light: pierreLight, dark: pierreDark },
  class: className,
  style,
  tabindex = 0,
  ...attributes
} = Astro.props;
const source = code ?? (await Astro.slots.render("default")) ?? "";
const supported = isSupportedLanguage(lang);
if (!supported) {
  console.warn(`[astro-highlights] Unsupported language ${JSON.stringify(lang)}. Rendering as plain text.`);
}
const result = codeToTokens(source, {
  lang: supported ? lang : "plaintext",
  themes,
  defaultColor: false,
});
// Pierre emits an empty final token row for an empty source or a trailing newline.
const lineCount = result.tokens.length - (result.tokens.at(-1)?.length === 0 ? 1 : 0);
const gutterStyle = lineNumbers ? { "--astro-highlights-gutter-width": `${String(lineCount).length}ch` } : undefined;
const themeStyles = Object.fromEntries(
  (result.rootStyle ?? "").split(";").map((declaration) => declaration.split(":")),
);
const preStyle = typeof style === "string" ? `${result.rootStyle};${style}` : { ...themeStyles, ...style };
const caption = title?.trim() || undefined;
const role = attributes.role ?? (caption ? "region" : undefined);
const label = attributes["aria-label"] ?? (attributes["aria-labelledby"] ? undefined : caption);
---

<CodeFrame title={caption}>
  <pre
    {...attributes}
    class:list={["astro-highlights", className]}
    style={preStyle}
    tabindex={tabindex}
    role={role}
    aria-label={label}
  ><code
      class={`language-${lang}`}
      style={gutterStyle}
    >{result.tokens.map((line, index) => <Fragment>{index > 0 ? "\n" : ""}<span class="line">{lineNumbers && index < lineCount && <span class="astro-highlights-line-number" aria-hidden="true" data-line-number={index + 1}></span>}{line.map((token) => <span style={token.htmlStyle}>{token.content}</span>)}</span></Fragment>)}</code></pre>
</CodeFrame>
